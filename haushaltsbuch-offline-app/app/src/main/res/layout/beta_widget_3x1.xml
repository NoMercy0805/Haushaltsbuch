<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="@drawable/widget_card_bg"
    android:paddingStart="7dp"
    android:paddingEnd="7dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/widget_amount_cover"
        android:gravity="center"
        android:text="▣"
        android:textColor="@color/widget_text"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haushaltsbuch+"
            android:textColor="@color/widget_text"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endsaldo"
            android:textColor="@color/widget_label"
            android:textSize="11sp"
            android:singleLine="true" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp">

            <LinearLayout
                android:id="@+id/widget_balance_pill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_amount_pill_neg">

                <TextView
                    android:id="@+id/widget_balance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="0,00 €"
                    android:textColor="@color/widget_balance_neg"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_balance_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_balance_privacy"
                android:gravity="center_vertical"
                android:text="••••••"
                android:textColor="@color/widget_cover_dots"
                android:textSize="19sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_minus_btn"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/widget_circle_toggle"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="normal"
        android:contentDescription="Buchung hinzufügen" />
</LinearLayout>
