<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/widget_plus_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_circle_plus"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_plus_bg"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_minus_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_circle_minus"
        android:gravity="center"
        android:text="\u2212"
        android:textColor="@color/widget_minus_bg"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical|end"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0,00 \u20ac"
            android:textColor="@color/widget_text"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kontostand"
            android:textColor="@color/widget_label"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
