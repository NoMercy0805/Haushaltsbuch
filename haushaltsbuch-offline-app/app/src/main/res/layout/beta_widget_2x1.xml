<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/widget_plus_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_circle_plus"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_plus_bg"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_minus_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_circle_minus"
        android:gravity="center"
        android:text="\u2212"
        android:textColor="@color/widget_minus_bg"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:paddingStart="8dp"
        android:text="0,00 \u20ac"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
