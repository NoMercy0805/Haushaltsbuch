<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/widget_plus_btn"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_circle_plus"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_plus_bg"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_minus_btn"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/widget_circle_minus"
        android:gravity="center"
        android:text="\u2212"
        android:textColor="@color/widget_minus_bg"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_balance_pill"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:background="@drawable/widget_amount_pill_neg"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0,00 \u20ac"
            android:textColor="@color/widget_balance_neg"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</LinearLayout>
