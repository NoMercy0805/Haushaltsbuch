<resources>
    <!-- DeviceDefault OHNE Light/Dark-Zusatz folgt automatisch der System-Einstellung
         (ab Android 10) fuer die eigentliche App-Oberflaeche (die die Web-App selbst
         per JS steuert). -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#1268FF</item>
        <item name="android:windowBackground">#F7F8FA</item>
        <item name="android:datePickerDialogTheme">@style/AppDatePickerDialogTheme</item>
    </style>

    <!-- Eigenes, immer helles Design fuer den nativen Datums-Dialog (den die
         WebView bei <input type="date"> automatisch aufruft) - unabhaengig vom
         System-Dunkelmodus, damit Text/Zahlen immer gut lesbar sind, und mit dem
         App-Blau als Akzentfarbe fuer den ausgewaehlten Tag. -->
    <style name="AppDatePickerDialogTheme" parent="android:Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">#1268FF</item>
    </style>
</resources>
